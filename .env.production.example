# Copy to a deployment secret store or an ignored local file. Never commit real values.
PMS_DEPLOYMENT_ENV=production
PMS_JWT_SECRET=replace_with_random_secret_at_least_32_bytes

OCEANBASE_HOST=db.example.internal
OCEANBASE_PORT=2881
OCEANBASE_DATABASE=brad_pms
OCEANBASE_USER=pms_app@tenant
OCEANBASE_PASSWORD=replace_with_runtime_secret

# Comma-separated formal frontend origins; every origin must be HTTPS.
PMS_CORS_ALLOWED_ORIGINS=https://pms.example.com
PMS_PUBLIC_BASE_URL=https://pms.example.com

# Production must never return reset/invitation tokens in API responses.
PMS_PASSWORD_RESET_EXPOSE_TOKEN=false
PMS_INVITATION_EXPOSE_TOKEN=false
PMS_NOTIFICATION_STARTUP_CHECK=true

# Set true only after providing all SMTP values through the secret store.
PMS_MAIL_ENABLED=false
# PMS_MAIL_HOST=smtp.example.com
# PMS_MAIL_PORT=587
# PMS_MAIL_USERNAME=replace_with_smtp_user
# PMS_MAIL_PASSWORD=replace_with_smtp_password
# PMS_MAIL_FROM=no-reply@example.com

# Keep local storage for a single-node deployment, or provide all S3 values.
PMS_STORAGE_TYPE=local
# PMS_STORAGE_TYPE=s3
# PMS_S3_ENDPOINT=https://object-storage.example.com
# PMS_S3_REGION=us-east-1
# PMS_S3_BUCKET=pms-uploads
# PMS_S3_ACCESS_KEY=replace_with_s3_access_key
# PMS_S3_SECRET_KEY=replace_with_s3_secret_key
