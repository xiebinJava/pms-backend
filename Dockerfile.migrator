FROM mysql:8.4

WORKDIR /app

# This image is the version-matched database bootstrap/migration tool used by
# the public distribution package. It intentionally contains migration code,
# but never contains credentials or application runtime configuration.
COPY docker/oceanbase-accounts-init.sh /usr/local/bin/oceanbase-accounts-init.sh
COPY docker/oceanbase-init.sh /usr/local/bin/oceanbase-init.sh
COPY scripts/oceanbase-upgrade.sh /usr/local/bin/oceanbase-upgrade.sh
COPY scripts/enterprise-preflight.sh /usr/local/bin/enterprise-preflight.sh
COPY scripts/verify-enterprise-migration.sh /usr/local/bin/verify-enterprise-migration.sh
COPY src/main/resources/db/migration /migrations

RUN chmod 0755 \
      /usr/local/bin/oceanbase-accounts-init.sh \
      /usr/local/bin/oceanbase-init.sh \
      /usr/local/bin/oceanbase-upgrade.sh \
      /usr/local/bin/enterprise-preflight.sh \
      /usr/local/bin/verify-enterprise-migration.sh

