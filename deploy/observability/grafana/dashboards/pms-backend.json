      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, path) (rate(pms_http_requests_seconds_bucket[5m])))", "legendFormat": "{{path}}", "refId": "A" }
