    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM memory",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (area) (jvm_memory_used_bytes)", "legendFormat": "used {{area}}", "refId": "A" },
        { "expr": "sum by (area) (jvm_memory_max_bytes)", "legendFormat": "max {{area}}", "refId": "B" }
