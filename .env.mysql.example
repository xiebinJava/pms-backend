# Copy to .env.mysql.local and keep the local file out of Git.
# Contributor local database only. Enterprise / OceanBase still uses brad_pms.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=pms
MYSQL_USER=pms
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

# At least 32 bytes. Generate with: openssl rand -hex 32
PMS_JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
PMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PMS_MANAGEMENT_ADDRESS=127.0.0.1
PMS_MANAGEMENT_PORT=8081
PMS_DB_CONNECTION_TIMEOUT_MS=3000
PMS_DB_VALIDATION_TIMEOUT_MS=1000
PMS_BOOTSTRAP_ADMIN_EMAIL=alex.zhang@example.com
PMS_BOOTSTRAP_ADMIN_NAME_ZH=张伟
PMS_BOOTSTRAP_ADMIN_USERNAME=alex.zhang
PMS_BOOTSTRAP_ADMIN_PASSWORD=replace_with_bootstrap_password_12_chars
PMS_DEPLOYMENT_ENV=development

# Local contributor defaults (production must override these values).
PMS_NOTIFICATION_STARTUP_CHECK=false
PMS_PASSWORD_RESET_EXPOSE_TOKEN=true
PMS_INVITATION_EXPOSE_TOKEN=true

# Optional enterprise sign-in. Leave off unless you have an IdP or directory.
# PMS_OIDC_ENABLED=false
# PMS_OIDC_ISSUER=https://idp.example.com
# PMS_OIDC_CLIENT_ID=pms
# PMS_OIDC_CLIENT_SECRET=replace_with_oidc_client_secret
# PMS_OIDC_REDIRECT_URI=http://localhost:5173/login/oidc/callback
# PMS_LDAP_ENABLED=false
# PMS_LDAP_URL=ldap://127.0.0.1:389
# PMS_LDAP_BASE_DN=dc=example,dc=com

# Optional object storage. Leave as local disk unless you run MinIO or a bucket.
# PMS_STORAGE_TYPE=s3
# PMS_S3_ENDPOINT=http://minio.example.com:9000
# PMS_S3_BUCKET=pms-uploads
# PMS_S3_ACCESS_KEY=replace_with_s3_access_key
# PMS_S3_SECRET_KEY=replace_with_s3_secret_key
# PMS_S3_PATH_STYLE=true

# Optional signed outbound events. Leave off unless a receiver is ready.
# PMS_WEBHOOK_ENABLED=false
# PMS_WEBHOOK_URL=https://hooks.example.com/pms
# PMS_WEBHOOK_SECRET=replace_with_webhook_secret_16
