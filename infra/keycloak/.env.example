# Development only. Use a secret manager or deployment environment variables outside local development.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-admin-password
KEYCLOAK_HTTP_PORT=8180

# PMS backend OIDC settings
PMS_OIDC_ENABLED=true
PMS_OIDC_ISSUER=http://127.0.0.1:8180/realms/pms
PMS_OIDC_CLIENT_ID=pms-web
PMS_OIDC_CLIENT_SECRET=
PMS_OIDC_REDIRECT_URI=http://127.0.0.1:5173/login/oidc/callback

# DSH's local host uses the same realm, but keeps its own public PKCE client.
DSH_OIDC_ENABLED=true
DSH_OIDC_ISSUER=http://127.0.0.1:8180/realms/pms
DSH_OIDC_CLIENT_ID=dsh-web
DSH_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/oidc/callback
